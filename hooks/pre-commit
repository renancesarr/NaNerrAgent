#!/usr/bin/env bash
# ADR-0007: deterministic gate. LLM enrichment is deferred (capture-human).
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
"$HOOK_DIR/check-agent-branch.sh"

TOUCHED=".context/touched"
PENDING=".context/pending-human.md"
STAGED=$(git diff --cached --name-only)

[ -z "$STAGED" ] && exit 0

if [ -f "$TOUCHED" ]; then
  # LC_ALL=C: comm compares in byte order; locale sort diverges from it
  DIVERGENT=$(LC_ALL=C comm -23 \
    <(echo "$STAGED" | LC_ALL=C sort) \
    <(LC_ALL=C sort -u "$TOUCHED"))
else
  DIVERGENT="$STAGED"
fi

if [ -n "$DIVERGENT" ]; then
  # -E: in BRE '+' is literal and '.+' never matches (bug found in 1st dogfood)
  if [ -f "$PENDING" ] && grep -Eq '^because: .+' "$PENDING"; then
    exit 0   # why present; capture-human expands it in the next session
  fi
  echo "✋ Out of the agent's flow:"
  echo "$DIVERGENT"
  echo ""
  echo "Fill .context/pending-human.md:"
  echo "  because:  <why you changed it>"
  echo "  concept:  <the idea behind it>"
  exit 1
fi

exit 0
